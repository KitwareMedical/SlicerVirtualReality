        </item>
        <item>
         <widget class="QPushButton" name="exitButton">
          <property name="enabled">
           <bool>false</bool>
          </property>
          <property name="toolTip">
           <string>Leave viewer mode and restore normal VR navigation.</string>
          </property>
          <property name="text">
           <string>Exit</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QPushButton" name="resetInteractionTransformsButton">
        <property name="toolTip">
         <string>Move all objects that have been repositioned by grabbing in virtual reality back to their original position, by resetting their interaction transforms to identity.</string>
        </property>
        <property name="text">
         <string>Reset interaction transforms</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="statusLabel">
        <property name="text">
         <string>Not active</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="settingsCollapsibleButton">
     <property name="text">
      <string>Behavior</string>
