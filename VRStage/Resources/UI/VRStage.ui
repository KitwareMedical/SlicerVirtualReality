   <hints>
    <hint type="sourcelabel">
     <x>180</x>
     <y>10</y>
    </hint>
    <hint type="destinationlabel">
     <x>180</x>
     <y>160</y>
    </hint>
   </hints>
  </connection>
 </connections>
