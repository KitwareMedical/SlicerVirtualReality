      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="defaultScaleLabel">
        <property name="text">
         <string>Default scale:</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QDoubleSpinBox" name="defaultScaleSpinBox">
        <property name="toolTip">
         <string>Real-world magnification (1.0 = normal VR size) used to frame the data on each reset, when Fit data to table is off.</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>defaultScale</string>
        </property>
        <property name="decimals">
         <number>2</number>
        </property>
        <property name="minimum">
         <double>0.010000000000000</double>
        </property>
        <property name="maximum">
         <double>100.000000000000000</double>
        </property>
        <property name="singleStep">
         <double>0.100000000000000</double>
        </property>
        <property name="value">
         <double>1.000000000000000</double>
        </property>
